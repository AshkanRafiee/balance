<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget card background for a dark widget, as literal colors. See widget_bg_light.xml for why
  the colors cannot be @color references. Must stay in step with @color/widget_bg and @color/divider
  in res/values-night/colors.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#0B1220" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#1E293B" />
</shape>
